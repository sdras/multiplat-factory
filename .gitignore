# deps / build
node_modules/
dist/
dist-release/
.nuxt/
.output/
.turbo/
coverage/
*.tsbuildinfo

# logs / env
*.log
.env
.env.*
!.env.example

# fixtures cache (pinned repos are synced here, never committed)
fixtures/.cache/

# platform build output inside templates/fixtures/workspaces
**/DerivedData/
**/.gradle/
**/build/
**/target/
# Rust build dirs only; the adapters keep their target adapters in src/target
!packages/adapters/src/target/
templates/**/*.xcodeproj
# in-house iOS fixtures ship an XcodeGen spec; the project is generated on use
fixtures/inhouse/**/*.xcodeproj
**/local.properties

# os / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
